# ============================================================================
# Event Photo Hub — Environment Variables
# ============================================================================
# Copy this file to .env.local for local development. On Netlify/Vercel,
# set these in the project's Environment Variables settings instead.
#
# NEVER commit .env.local or any file containing real values.
# Anything NOT prefixed with NEXT_PUBLIC_ is server-only and must never be
# referenced from a "use client" component — see src/lib/supabase/admin.ts
# and src/lib/storage/r2Client.ts, both guarded with `import "server-only"`
# so this is enforced at build time, not just by convention.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Project Settings → API → service_role key.
# Bypasses Row Level Security entirely — treat this like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 -----------------------------------------------------------
# Dashboard → R2 → Manage R2 API Tokens → create a token scoped to ONLY
# your event-photos bucket (Object Read & Write). Do not use an
# account-wide token.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=event-photo-hub

# Public hostname for reading gallery/thumbnail images directly (NOT
# originals — those stay behind presigned URLs). Either:
#   (a) R2.dev dev subdomain, enabled per-bucket under Settings → Public
#       Access, host looks like: pub-xxxxxxxx.r2.dev
#   (b) a custom domain you've attached to the bucket, e.g.
#       photos-cdn.yourdomain.com
NEXT_PUBLIC_R2_PUBLIC_HOST=pub-xxxxxxxx.r2.dev

# --- App ---------------------------------------------------------------------
# Used to build absolute guest/gallery URLs for QR codes and copy-link
# buttons. Set to your real production domain when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
